# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase access (never prefix this with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI assistant
OPENAI_API_KEY=your-openai-api-key

# Stripe billing (all values are server-only)
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_WEEKLY_PRICE_ID=price_weekly
STRIPE_MONTHLY_PRICE_ID=price_monthly
STRIPE_LIFETIME_PRICE_ID=price_lifetime

# Canonical HTTPS production origin, without a trailing slash
APP_URL=https://drivetest.pro

# Search visibility and privacy-safe traffic measurement
GOOGLE_SITE_VERIFICATION=your-google-search-console-token
BING_SITE_VERIFICATION=your-bing-webmaster-tools-token
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
